# Google Maps JavaScript API key for the browser (Maps JavaScript API enabled)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Google Maps Map ID (required by AdvancedMarker). Defaults to
# DEMO_MAP_ID, which is fine for development.
# VITE_GOOGLE_MAP_ID=

# Google Geocoding API key for the Go server, which places new projects on the
# map after each scrape. Use a separate key from the browser one above: it
# should have only the Geocoding API enabled and, since requests come from the
# server, an IP restriction rather than an HTTP-referrer one. Without it,
# projects are still scraped and served but none get a pin.
GEOCODING_API_KEY=

# Local Postgres for docker compose (the password is required; the user and
# database name default to "doti"). These only take effect the first time the
# db-data volume is created: to change them afterwards, run
# `docker compose down -v` (this deletes the local database).
POSTGRES_PASSWORD=
# POSTGRES_USER=doti
# POSTGRES_DB=doti
